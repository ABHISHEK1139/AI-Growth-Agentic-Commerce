# ---------------------------------------------------------------------------
# AgentPay environment template
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. NEVER commit a real .env file.
# Every value below is a safe local-development placeholder. The defaults are
# deliberately chosen so that a clean clone runs end to end with NO credentials:
# the payment provider and the model provider both default to local fakes.
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
APP_ENV=local                      # local | staging | demo
APP_NAME=agentpay
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000

# --- Datastores -----------------------------------------------------------
# Host-side URL. Inside Docker Compose the host is `postgres` / `redis`.
DATABASE_URL=postgresql+psycopg://agentpay:agentpay@localhost:5432/agentpay
REDIS_URL=redis://localhost:6379/0

# --- Rate limiting --------------------------------------------------------
# Redis-backed, per actor when one is known and per client address otherwise.
# The limiter FAILS OPEN: if Redis is unreachable, requests are allowed and the
# degradation is logged, because a protective control must not take down the
# payment path. Per-route limits are declared in code (payments 10/min, catalog
# search 60/min, ...); the value below applies only to routes without a rule.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_REDIS_TIMEOUT_SECONDS=0.25
# How long to stop calling Redis after a failure, so an outage does not add its
# connect timeout to every request.
RATE_LIMIT_DEGRADED_COOLDOWN_SECONDS=10

# --- Security -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-generate-a-real-secret-before-staging
SESSION_SECRET=dev-only-change-me-too
# Two secrets on purpose: JWT_SECRET signs the scoped bearer tokens external
# agents carry, SESSION_SECRET signs the web session. Neither value can be
# presented where the other belongs, so one leaking does not compromise both.
# Both TTLs are bounded in code (access 60s-24h, session 5m-30d).
ACCESS_TOKEN_TTL_SECONDS=3600
SESSION_TTL_SECONDS=86400
# Comma-separated. Restricted by default; never use "*" outside local.
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Payment provider -----------------------------------------------------
# `fake` is the default so the full golden path and the entire test suite run
# without any Razorpay account. Switch to `razorpay` only for a test-mode demo.
PAYMENT_PROVIDER=fake              # fake | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Applies to every outbound provider call, whichever provider is selected.
PAYMENT_PROVIDER_TIMEOUT_SECONDS=10

# --- Model provider -------------------------------------------------------
# There is no vendor name anywhere in the code. Every OpenAI-compatible
# endpoint is reached through one adapter, selected by base URL, so changing
# provider or rotating an expiring key is a change to this file and nothing
# else. See docs/adr/0010-model-provider-abstraction.md.
#
# `mock` is the default so the golden path and the whole test suite run with no
# credential at all.
MODEL_PROVIDER=mock                # mock | openai_compatible
MODEL_API_KEY=
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=llama-3.3-70b-versatile

# To switch provider, change BASE_URL and NAME together:
#
#   Groq (Meta Llama 3.3)   https://api.groq.com/openai/v1      llama-3.3-70b-versatile
#   OpenAI                  https://api.openai.com/v1           gpt-4o
#   Together (Llama 3.3)    https://api.together.xyz/v1         meta-llama/Llama-3.3-70B-Instruct-Turbo
#   Fireworks               https://api.fireworks.ai/inference/v1
#   OpenRouter              https://openrouter.ai/api/v1
#   local vLLM (Llama 3.3)  http://localhost:8000/v1            meta-llama/Llama-3.3-70B-Instruct
#   Ollama                  http://localhost:11434/v1           qwen3.5:4b
#
# WORKED EXAMPLE 1 --- hosted, metered. Every /api/explore call is billed by the
# token, so a demo that reloads a search page pays for each reload:
#
#   MODEL_PROVIDER=openai_compatible
#   MODEL_BASE_URL=https://api.groq.com/openai/v1
#   MODEL_NAME=llama-3.3-70b-versatile
#   MODEL_API_KEY=gsk_...                 # required: the endpoint is not this host
#
# WORKED EXAMPLE 2 --- on this host, free. Same adapter, same wire format, same
# timeout / retry / token settings. The cost difference is the whole point: this
# path bills nothing at all, ever, no matter how many requests a demo makes. You
# pay in RAM and a little latency instead of per token. `ollama pull qwen3.5:4b`:
#
#   MODEL_PROVIDER=openai_compatible
#   MODEL_BASE_URL=http://localhost:11434/v1
#   MODEL_NAME=qwen3.5:4b
#   MODEL_API_KEY=                        # EMPTY, and left empty on purpose
#   MODEL_TIMEOUT_SECONDS=120             # see below: a cold local model is slow
#
# Raise MODEL_TIMEOUT_SECONDS for the local path. The 30s default is sized for a
# hosted endpoint; measured on this host, the first request after a cold start took
# roughly 75-100s while the weights loaded. The retry budget applies on top, so the
# default turns one cold start into three timeouts and a degraded search.
#
# MODEL_API_KEY is required only for an endpoint that is not on this host. A local
# server has no credential to present, and an empty `Bearer` header would be
# accepted while recording the call as authenticated, so none is sent. Startup
# validation knows the difference: it decides by parsing the host of
# MODEL_BASE_URL, so `localhost`, `127.0.0.1`, and `::1` need no key while
# anything else still does.
#
# Note that a smaller local model is likelier to answer with prose or a fenced
# code block than with clean JSON. That is reported as a failure rather than
# silently becoming an intent with no constraints, so `/api/explore` says so in
# `warnings` instead of returning an unfiltered result set that looks like an
# answer.

# Reserved for content moderation. NEITHER of these configures the prompt guard
# any more --- see the "Prompt guard" section below. They used to, which meant
# setting MODEL_API_KEY above silently added a second billed request in front of
# every query.
MODEL_GUARD_NAME=llama-guard-3-8b
MODEL_MODERATION_NAME=llama-guard-3-8b

MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_TOKENS=2048
MODEL_MAX_RETRIES=2

# Capability flags, not vendor branches. Set these per endpoint rather than
# adding provider-specific code paths.
MODEL_SUPPORTS_JSON_SCHEMA=true
MODEL_SUPPORTS_TOOL_CALLING=true
# Strict structured-output mode requires every declared property to appear in
# `required`, so optional fields must be nullable-typed rather than omitted.
MODEL_STRICT_SCHEMA_REQUIRES_ALL_REQUIRED=true

# --- Prompt guard ---------------------------------------------------------
# The prompt guard is configured here and NOWHERE else. It has its own endpoint,
# model, and credential precisely so that enabling the reasoning model above does
# not enable a second billed request per query, which is what it used to do.
#
# The choice is a cost decision as much as a security one:
#
#   heuristic  Deterministic in-process checks only. Never leaves the process.
#              Zero network calls, zero cost. THIS IS THE DEFAULT.
#   local      Also runs Meta Llama Guard over an OpenAI-compatible endpoint on
#              this host (Ollama below). Never leaves the host, so still zero
#              cost --- you pay in RAM and about 80ms, not per token.
#   remote     Same request against a metered provider. BILLED ON EVERY REQUEST.
#              An /api/explore call in this mode makes two provider calls, not
#              one: the reasoning model, plus ~15 tokens of guard.
#
# Layer 1 (the length bound and the injection pattern set) runs first in all
# three modes regardless, because it is free.
GUARD_PROVIDER=heuristic            # heuristic | local | remote
# For `local`: Ollama's OpenAI-compatible route. `ollama pull llama-guard3:1b`.
# For `remote`: the provider's base URL, e.g. https://api.groq.com/openai/v1
GUARD_BASE_URL=http://localhost:11434/v1
GUARD_MODEL_NAME=llama-guard3:1b
# Used by `remote` only, and required when it is selected. Left empty, no
# Authorization header is sent at all, which is what the local path wants.
GUARD_API_KEY=
# Bounded in code (0 < t <= 30). The guard sits in front of every prompt, so a
# stalled classifier must not become the latency of the request.
GUARD_TIMEOUT_SECONDS=5

# --- Web search (research agent, Task 36) ---------------------------------
# `null` is the default: the golden path and the whole test suite never touch the
# network. See docs/adr/0009-web-search-provider.md.
#
# SEARXNG_BASE_URL is configuration, never a request parameter. Nothing a model
# emits or a caller sends can redirect the search client at another host --- that
# separation is what keeps the SSRF control on `open_url` intact.
SEARCH_PROVIDER=null               # null | searxng
SEARXNG_BASE_URL=http://localhost:8080
# Bounded research loop. Upstream engines throttle; these are correctness limits,
# not politeness. See base doc 18.2.
RESEARCH_MAX_SEARCHES=3
RESEARCH_MAX_PAGES=5
RESEARCH_MAX_STEPS=6
RESEARCH_PAGE_TIMEOUT_SECONDS=10
RESEARCH_MAX_PAGE_BYTES=2000000
RESEARCH_CACHE_TTL_SECONDS=86400

# --- Object storage (images, raw import archives) -------------------------
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=agentpay-local
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- Dataset pipeline -----------------------------------------------------
# RAW_DIR points at the immutable source .gz files. They are read in place,
# never decompressed to disk and never modified.
AGENTPAY_RAW_DIR=../datasets
AGENTPAY_OUT_DIR=./data/out
# Cap lines read per source file for a fast validation run. Empty = no cap.
MAX_LINES_DEBUG=200000

# --- Web frontend (apps/web) ----------------------------------------------
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle at build
# time. Never put a secret here: these two are a public origin and a publishable
# key, and nothing else belongs in this block.
#
# NEXT_PUBLIC_API_BASE_URL is an ORIGIN, with no path. Leave it EMPTY for the
# normal case: the frontend calls relative paths (`/api/v1/...`) and
# `apps/web/next.config.js` rewrites them to the API, so one origin serves both
# and no host is baked into the bundle. Set it only when the API is not reachable
# through the frontend's own origin. A trailing `/api` or `/api/v1` is stripped by
# `apps/web/src/lib/api.ts`, because callers pass the full path themselves --- note
# that the `web` service in docker-compose.yml sets this to
# `http://localhost:8000/api/v1`, which that normalisation is there to absorb.
NEXT_PUBLIC_API_BASE_URL=
# Razorpay PUBLISHABLE key id (the `rzp_test_...` / `rzp_live_...` value, never
# the secret). There is no default and no fallback anywhere in the web tree: with
# this empty the checkout screens state that the payment provider is not
# configured and refuse to open a payment modal, which is the correct behaviour
# for a deployment that has not been given its own key. The secret half lives in
# RAZORPAY_KEY_SECRET above and never reaches the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Commerce defaults ----------------------------------------------------
DEFAULT_CURRENCY=INR
DEFAULT_MERCHANT_ID=merchant_demo
CHECKOUT_EXPIRY_SECONDS=900
AUTHORIZATION_EXPIRY_SECONDS=900
MAX_SEARCH_RESULTS=20
# Amounts are integer minor units (paise). 500000 paise = INR 5,000.
AUTO_APPROVAL_LIMIT_MINOR=500000
MAX_TRANSACTION_AMOUNT_MINOR=7000000
