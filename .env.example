ACCESS_TOKEN_TTL_SECONDS=
AGENTPAY_OUT_DIR=
AGENTPAY_RAW_DIR=
# Gate for live credentials: without ALLOW_LIVE_CREDENTIALS=1 the app ignores
# ambient environment values and bundled .env secrets, running fully offline.
ALLOW_LIVE_CREDENTIALS=
ALLOW_CONSOLE_SIGNUP=
# Set to 1 to fall back to a local SQLite file when Postgres is unreachable.
# Leave unset outside local: a deployment that cannot reach its database should
# refuse to start rather than serve an empty catalog from a scratch file.
ALLOW_SQLITE_FALLBACK=
API_HOST=
API_PORT=
APP_ENV=
APP_NAME=
AUTHORIZATION_EXPIRY_SECONDS=
AUTO_APPROVAL_LIMIT_MINOR=
CHECKOUT_EXPIRY_SECONDS=
# Master key for channel access tokens at rest. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it makes every stored connection token undecryptable.
CHANNEL_ENCRYPTION_KEY=
CORS_ALLOW_ORIGINS=
# The datastore, as discrete parts. DATABASE_URL, if set, overrides all of them.
DB_DRIVER=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECT_TIMEOUT_SECONDS=

# Connection pool, per uvicorn worker. Total connections against Postgres are
# (DB_POOL_SIZE + DB_MAX_OVERFLOW) * workers; the API image runs 2 workers, so the
# defaults give 30 of Postgres' default 100. Raise only alongside max_connections —
# exceeding it makes new connections fail rather than merely queueing.
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
# Recycle pooled connections after this many seconds so a proxy or PgBouncer dropping
# an idle connection cannot surface as a failed request.
DB_POOL_RECYCLE_SECONDS=

DATABASE_URL=
DEFAULT_CURRENCY=
DEFAULT_MERCHANT_ID=
GEMINI_API_KEY=
# Web-tier only (see GROK_* note above); the backend uses MODEL_* instead.
GUARD_API_KEY=
GUARD_BASE_URL=
GUARD_MODEL_NAME=
GUARD_PROVIDER=
GUARD_TIMEOUT_SECONDS=
JWT_SECRET=
LOG_LEVEL=
MAX_LINES_DEBUG=
MAX_SEARCH_RESULTS=
MAX_TRANSACTION_AMOUNT_MINOR=
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_GUARD_NAME=
MODEL_MAX_RETRIES=
MODEL_MAX_TOKENS=
MODEL_MODERATION_NAME=
MODEL_NAME=
# mock | openai_compatible | groq | grok | ollama | local
MODEL_PROVIDER=
# xAI Grok API configuration (web tier only: apps/web grok/chat route reads
# these; the FastAPI backend has no grok_* fields and ignores them):
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-latest
MODEL_STRICT_SCHEMA_REQUIRES_ALL_REQUIRED=
MODEL_SUPPORTS_JSON_SCHEMA=
MODEL_SUPPORTS_TOOL_CALLING=
MODEL_TIMEOUT_SECONDS=
NEXT_PUBLIC_API_BASE_URL=
# Baked into the web bundle at build time: pass as a docker build-arg
# (compose does this). A runtime-only -e value is silently ignored.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_SECRET_KEY=
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_TIMEOUT_SECONDS=
RATE_LIMIT_DEFAULT_PER_MINUTE=
RATE_LIMIT_DEGRADED_COOLDOWN_SECONDS=
RATE_LIMIT_ENABLED=
RATE_LIMIT_REDIS_TIMEOUT_SECONDS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
REDIS_URL=

# --- Read cache (packages/cache.py) ------------------------------------
# Measured to move clean capacity from 200 to ~500 req/s; see
# docs/production/capacity-report.md. Requires REDIS_URL: the cache is only correct
# for a multi-worker deployment when the store is shared.
CACHE_ENABLED=1
CACHE_ALLOW_PROCESS_LOCAL=
# Short by design. An offer is a price, so a stale entry is a wrong price. Write paths
# also invalidate explicitly, after their commit.
CACHE_TTL_SECONDS_OFFER=
CACHE_TTL_SECONDS_PRODUCT=
CACHE_TTL_SECONDS_CAPABILITY=
# A cache outage must not amplify latency, so the backend stops attempting connections
# for this long after a failure instead of paying the timeout on every request.
CACHE_TIMEOUT_SECONDS=
CACHE_COOLDOWN_SECONDS=
#
# CACHE_ALLOW_PROCESS_LOCAL=1 permits a per-process cache when no Redis is configured.
# That is CORRECT ONLY FOR A SINGLE PROCESS: with several workers each holds its own
# copy, invalidations do not propagate, and a reader can be served a stale offer price
# until its TTL expires. Left unset, a missing REDIS_URL disables caching entirely --
# slower, and correct.
RESEARCH_CACHE_TTL_SECONDS=
RESEARCH_MAX_PAGES=
RESEARCH_MAX_PAGE_BYTES=
RESEARCH_MAX_SEARCHES=
RESEARCH_MAX_STEPS=
RESEARCH_PAGE_TIMEOUT_SECONDS=
SEARCH_PROVIDER=
SEARXNG_BASE_URL=
SESSION_SECRET=
SESSION_TTL_SECONDS=
# Playwright e2e harness base URL (apps/web/playwright.config.ts).
PLAYWRIGHT_BASE_URL=http://localhost:3000
# File backup/restore scripts (infra/operations/backup.sh, restore.sh).
BACKUP_DIR=/var/backups/agentpay
RESTORE_FILE=
RESTORE_CONFIRM=no