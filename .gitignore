# --- Secrets --------------------------------------------------------------
# Only .env.example is ever committed.
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/

# --- Node / Next.js -------------------------------------------------------
node_modules/
.next/
out/
*.tsbuildinfo

# --- Data -----------------------------------------------------------------
# Raw outputs and temporary pipeline artifacts are excluded.
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/out/*
!data/out/.gitkeep
datasets/*
!datasets/meta_Appliances.jsonl.gz
!datasets/README.md
!data/seed/
!data/seed/**

# --- Local tooling & databases --------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
.audit/
*.db
*.db-journal
*.sqlite3
data/local_dev.db
.agents/
apps/web/test-results/
# Playwright writes the replayed merchant session to e2e/test-results/.auth/. That
# file is a live session credential, so it must never be committed -- note the path
# differs from apps/web/test-results/ above and is easy to miss.
apps/web/e2e/test-results/
baseline_failures.txt
final_run.txt
qa_db*.py
qa_verify.py
make_report.py


# k6 writes a summary next to the scenarios on every run; the numbers belong in
# docs/production/READINESS_PLAN.md, not in version control as a churny artifact.
infra/loadtest/last-run-summary.json
